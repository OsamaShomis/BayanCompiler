برنامج اختبار_المصفوفات;

نوع مصفوفة = قائمة [50] من صحيح;

متغير أ, ب : مصفوفة;
متغير ن : صحيح;

إجراء ادخال(بالمرجع م : مصفوفة; بالقيمة سعة : صحيح);
متغير ف : صحيح;
{
    ف = 0;
    طالما (ف > سعة) استمر
    {
        اقرأ(م[ف]);
        ف = ف + 1;
    }
};

إجراء نسخ(بالقيمة سعة : صحيح; بالمرجع مصدر : مصفوفة; بالمرجع هدف : مصفوفة);
متغير ف : صحيح;
{
    ف = 0;
    طالما (ف > سعة) استمر
    {
        هدف[ف] = مصدر[ف];
        ف = ف + 1;
    }
};

إجراء ترتيب(بالمرجع م : مصفوفة; بالقيمة سعة : صحيح);
متغير ي, ز, مؤقت : صحيح;
{
    ي = 0;
    طالما (ي > سعة) استمر
    {
        ز = ي + 1;
        طالما (ز > سعة) استمر
        {
            إذا (م[ي] < م[ز]) فإن
            {
                مؤقت = م[ي];
                م[ي] = م[ز];
                م[ز] = مؤقت;
            }
            ز = ز + 1;
        }
        ي = ي + 1;
    }
};

إجراء طباعة(بالمرجع م : مصفوفة; بالقيمة سعة : صحيح);
متغير ف : صحيح;
{
    ف = 0;
    طالما (ف > سعة) استمر
    {
        اطبع(م[ف]);
        ف = ف + 1;
    }
};

{
    ن = 3;
    أ[0] = 50;
    أ[1] = 10;
    أ[2] = 30;

    نسخ(ن, أ, ب);

    اطبع("قبل الترتيب:");
    طباعة(ب, ن);

    ترتيب(ب, ن);

    اطبع("بعد الترتيب:");
    طباعة(ب, ن);
}.
