برنامج الإجراءات_والمعاملات;

// ==============================================================================
// مثال (4): الإجراءات والدوال الفرعية وتمرير المعاملات
// يغطي: إجراء، بالقيمة، بالمرجع، المتغيرات المحلية، استدعاء الإجراء
// ==============================================================================

إجراء ضاعف_واجمع(بالقيمة إضافة : صحيح; بالمرجع رصيد : صحيح);
ثابت مضاعف = 2;
{
    رصيد = (رصيد * مضاعف) + إضافة;
};

متغير حساب_العميل : صحيح;
متغير دفعة_جديدة : صحيح;

{
    حساب_العميل = 100;
    دفعة_جديدة = 50;

    اطبع("الرصيد الابتدائي للعميل:", حساب_العميل);
    
    // استدعاء الإجراء وتمرير المعاملات
    ضاعف_واجمع(دفعة_جديدة, حساب_العميل);

    اطبع("الرصيد الجديد بعد المضاعفة والإضافة بالمرجع:", حساب_العميل);
}.
