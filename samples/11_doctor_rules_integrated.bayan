برنامج التحقق_الرسمي;

ثابت حد = 5;
نوع قائمة_أعداد = قائمة[5] من صحيح;
نوع نقطة = سجل { س : صحيح; ص : صحيح };
متغير عداد, مجموع : صحيح;

إجراء زد(بالقيمة قيمة : صحيح; بالمرجع نتيجة : صحيح);
ثابت واحد = 1;
{
    نتيجة = نتيجة + قيمة;
};

{
    عداد = 1;
    مجموع = 0;
    كرر (عداد = 1 إلى حد أضف 1) {
        زد(عداد, مجموع);
    }
    اطبع("المجموع", مجموع);
}.
