برنامج العمليات_المتقدمة;

// ==============================================================================
// مثال (8): العمليات الحسابية المتقدمة (الأس والقسمة الصحيحة)
// يغطي: معامل الأس (^)، معامل القسمة الصحيحة (\)، ترتيب الأولويات
// ==============================================================================

ثابت الأساس = 2;
ثابت الأس_المطلوب = 4;

متغير نتيجة_القوة : صحيح;
متغير حاصل_القسمة : صحيح;
متغير تعبير_مركب : صحيح;

{
    // حساب 2^4 = 16
    نتيجة_القوة = الأساس ^ الأس_المطلوب;

    // حساب 19 \ 4 = 4 (قسمة صحيحة بدون كسور)
    حاصل_القسمة = 19 \ 4;

    // تعبير يجمع الأس مع القسمة الصحيحة والجمع
    تعبير_مركب = (3 ^ 2) + (25 \ 5);

    اطبع("حساب القوة 2 أس 4 يساوي:", نتيجة_القوة);
    اطبع("ناتج القسمة الصحيحة لـ 19 على 4:", حاصل_القسمة);
    اطبع("نتيجة التعبير المركب (3^2 + 25\\5):", تعبير_مركب);
}.
