برنامج النصوص_والمحارف;

// ==============================================================================
// مثال (9): السلاسل النصية ونوع المحارف
// يغطي: متغير ... : خيط رمزي، متغير ... : حرفي، طباعة الرسائل العربية
// ==============================================================================

متغير عنوان_الرسالة : خيط رمزي;
متغير اسم_اللغة : خيط رمزي;
متغير رمز_الدرجة : حرفي;
متغير رمز_الحالة : حرفي;

{
    اسم_اللغة = "لغة بيان العربية";
    عنوان_الرسالة = "مرحباً بكم في بيئة التطوير";
    رمز_الدرجة = 'A';
    رمز_الحالة = 'S';

    اطبع("عنوان الرسالة الترحيبية:", عنوان_الرسالة);
    اطبع("اسم لغة البرمجة:", اسم_اللغة);
    اطبع("رمز التقدير المستحق:", رمز_الدرجة);
    اطبع("رمز الحالة الإيجابي:", رمز_الحالة);
}.
