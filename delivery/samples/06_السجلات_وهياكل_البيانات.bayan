برنامج السجلات_وهياكل_البيانات;

// ==============================================================================
// مثال (6): السجلات (Records) وهياكل البيانات المركبة
// يغطي: نوع ... = سجل { ... }، إسناد وقراءة الحقول المركبة
// ==============================================================================

نوع نقطة_هندسية = سجل {
    س : صحيح;
    ص : صحيح;
    رمز : حرفي
};

متغير نقطة_أ : نقطة_هندسية;
متغير نقطة_ب : نقطة_هندسية;
متغير مجموع_الإحداثيات : صحيح;

{
    // تهيئة حقول النقطة الأولى
    نقطة_أ.س = 10;
    نقطة_أ.ص = 20;
    نقطة_أ.رمز = 'A';

    // تهيئة حقول النقطة الثانية
    نقطة_ب.س = 30;
    نقطة_ب.ص = 40;
    نقطة_ب.رمز = 'B';

    // إجراء حسابات على حقول السجل
    مجموع_الإحداثيات = نقطة_أ.س + نقطة_أ.ص + نقطة_ب.س + نقطة_ب.ص;

    اطبع("=== بيانات النقطة [أ] ===");
    اطبع("الإحداثي السيني (س) = ", نقطة_أ.س);
    اطبع("الإحداثي الصادي (ص) = ", نقطة_أ.ص);
    اطبع("رمز النقطة المميز = ", نقطة_أ.رمز);

    اطبع("=== بيانات النقطة [ب] ===");
    اطبع("الإحداثي السيني (س) = ", نقطة_ب.س);
    اطبع("الإحداثي الصادي (ص) = ", نقطة_ب.ص);
    اطبع("رمز النقطة المميز = ", نقطة_ب.رمز);

    اطبع("=== إجمالي الإحداثيات ===");
    اطبع("المجموع الكلي = ", مجموع_الإحداثيات);
}.
