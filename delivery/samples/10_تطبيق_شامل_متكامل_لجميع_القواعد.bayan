برنامج النظام_المالي_المتكامل;

// ==============================================================================
// مثال (10): التطبيق الشامل المتكامل لكافة قواعد وخصائص لغة بيان
// يجمع: الثوابت، السجلات، القوائم، الإجراءات، الحلقات، الشروط، وأنواع البيانات
// ==============================================================================

// 1. تعريف الثوابت
ثابت نسبة_الضريبة = 0.05;
ثابت حد_العملاء = 3;

// 2. تعريف السجلات والقوائم
نوع تفاصيل_فاتورة = سجل {
    رقم_الفاتورة : صحيح;
    رمز_الفئة : حرفي;
    المبلغ : صحيح
};

نوع قائمة_فواتير = قائمة[3] من صحيح;

// 3. تعريف المتغيرات
متغير قائمة_المبالغ : قائمة_فواتير;
متغير فاتورة_رئيسية : تفاصيل_فاتورة;
متغير عداد, إجمالي_المبيعات : صحيح;
متغير ضريبة_المبيعات : حقيقي;
متغير عنوان_التقرير : خيط رمزي;

// 4. تعريف الإجراء الفرعي لمعالجة الفواتير
إجراء أضف_إلى_الإجمالي(بالقيمة مبلغ_الفاتورة : صحيح; بالمرجع الإجمالي : صحيح);
{
    الإجمالي = الإجمالي + مبلغ_الفاتورة;
};

// 5. كتلة التنفيذ الرئيسية
{
    عنوان_التقرير = "تقرير الحسابات والمبيعات اليومي";
    اطبع("=== " , عنوان_التقرير);

    // تهيئة السجل
    فاتورة_رئيسية.رقم_الفاتورة = 101;
    فاتورة_رئيسية.رمز_الفئة = 'V';
    فاتورة_رئيسية.المبلغ = 500;

    // تهيئة القائمة
    قائمة_المبالغ[0] = 150;
    قائمة_المبالغ[1] = 250;
    قائمة_المبالغ[2] = 350;

    إجمالي_المبيعات = فاتورة_رئيسية.المبلغ;

    // تكرار لحساب الإجمالي عبر استدعاء الإجراء
    كرر (عداد = 0 إلى 2 أضف 1) {
        أضف_إلى_الإجمالي(قائمة_المبالغ[عداد], إجمالي_المبيعات);
    }

    // حساب الضريبة
    ضريبة_المبيعات = إجمالي_المبيعات * نسبة_الضريبة;

    اطبع("رقم الفاتورة المميزة:", فاتورة_رئيسية.رقم_الفاتورة);
    اطبع("فئة الفاتورة:", فاتورة_رئيسية.رمز_الفئة);
    اطبع("إجمالي المبيعات المحسوب:", إجمالي_المبيعات);
    اطبع("قيمة الضريبة المقدرة:", ضريبة_المبيعات);

    // قرار التحفيز المالي
    إذا (إجمالي_المبيعات >= 1000) فإن {
        اطبع("النتيجة: تم تحقيق المستهدف المالي وتستحق المكافأة!");
    } وإلا {
        اطبع("النتيجة: لم يتم بلوغ المستهدف المالي لهذا اليوم.");
    }
}.
