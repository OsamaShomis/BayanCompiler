برنامج خوارزميات_التكرار;

// ==============================================================================
// مثال (3): حلقات التكرار والمجاميع الحسابية
// يغطي: طالما ... استمر، كرر ... إلى ... أضف، أعد ... حتى
// ==============================================================================

ثابت الحد_الأقصى = 5;

متغير عداد, مجموع : صحيح;
متغير مضروب : صحيح;
متغير متبقي : صحيح;

{
    // 1. حلقة طالما لحساب مجموع الأعداد من 1 إلى 5
    عداد = 1;
    مجموع = 0;
    طالما (عداد <= الحد_الأقصى) استمر {
        مجموع = مجموع + عداد;
        عداد = عداد + 1;
    }
    اطبع("مجموع الأعداد من 1 إلى 5 باستخدام طالما:", مجموع);

    // 2. حلقة كرر لحساب مضروب العدد 4 (4! = 1 * 2 * 3 * 4)
    مضروب = 1;
    كرر (عداد = 1 إلى 4 أضف 1) {
        مضروب = مضروب * عداد;
    }
    اطبع("مضروب العدد 4 باستخدام كرر:", مضروب);

    // 3. حلقة أعد ... حتى للتناقص التدريجي
    متبقي = 3;
    أعد {
        متبقي = متبقي - 1;
    } حتى (متبقي == 0)
    اطبع("القيمة النهائية للمتبقي بعد أعد حتى:", متبقي);
}.
