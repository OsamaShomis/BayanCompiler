برنامج حساب_المساحات_والثوابت;

// ==============================================================================
// مثال (1): تعريف المتغيرات والثوابت والعمليات الحسابية الأساسية
// يغطي: ثابت، متغير، صحيح، حقيقي، العمليات الحسابية (+، -، *، /، %)
// ==============================================================================

ثابت النسبة_التقريبية = 3.14;
ثابت معامل_التوسيع = 2;

متغير نصف_القطر : حقيقي;
متغير مساحة_الدائرة : حقيقي;
متغير الطول, العرض, مساحة_المستطيل, محيط_المستطيل : صحيح;
متغير باقي_القسمة : صحيح;

{
    // حسابات المستطيل
    الطول = 15;
    العرض = 10;
    مساحة_المستطيل = الطول * العرض;
    محيط_المستطيل = (الطول + العرض) * معامل_التوسيع;
    باقي_القسمة = الطول % العرض;

    // حسابات الدائرة
    نصف_القطر = 7.0;
    مساحة_الدائرة = النسبة_التقريبية * نصف_القطر * نصف_القطر;

    // طباعة النتائج
    اطبع("مساحة المستطيل تساوي:", مساحة_المستطيل);
    اطبع("محيط المستطيل يساوي:", محيط_المستطيل);
    اطبع("باقي قسمة الطول على العرض:", باقي_القسمة);
    اطبع("مساحة الدائرة التقديرية:", مساحة_الدائرة);
}.
