برنامج الحسابات_العلمية;

// ==============================================================================
// مثال (7): الحسابات العلمية ونوع الأعداد الحقيقية (Real Floats)
// يغطي: متغير ... : حقيقي، العمليات العشرية، المقارنات الشرطية العشرية
// ==============================================================================

ثابت ثابت_الجاذبية = 9.8;
ثابت الكتلة = 2.5;

متغير القوة_المحسوبة : حقيقي;
متغير الحد_الأمان : حقيقي;

{
    الحد_الأمان = 20.0;

    // حساب القوة = الكتلة * الجاذبية
    القوة_المحسوبة = الكتلة * ثابت_الجاذبية;

    اطبع("القوة المحسوبة بالنيوتن:", القوة_المحسوبة);

    // فحص تخطي الحد المسموح
    إذا (القوة_المحسوبة > الحد_الأمان) فإن {
        اطبع("تحذير: القوة تجاوزت الحد الآمن للمنظومة!");
    } وإلا {
        اطبع("الحالة طبيعية: القوة ضمن النطاق الآمن.");
    }
}.
