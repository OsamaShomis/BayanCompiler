برنامج حساب_معدل_طالب;

نوع طالب = سجل {
    درجة_أولى : صحيح;
    درجة_ثانية : صحيح;
    ناجح : منطقي
};

متغير أحمد : طالب;
متغير مجموع_الدرجات : صحيح;
متغير المعدل : حقيقي;

إجراء احسب_المجموع(بالقيمة د1 : صحيح; بالقيمة د2 : صحيح; بالمرجع ناتج : صحيح);
{
    ناتج = د1 + د2;
};

{
    أحمد.درجة_أولى = 85;
    أحمد.درجة_ثانية = 95;
    
    احسب_المجموع(أحمد.درجة_أولى, أحمد.درجة_ثانية, مجموع_الدرجات);
    
    المعدل = مجموع_الدرجات / 2;
    
    إذا (المعدل =< 60) فإن {
        أحمد.ناجح = صح;
        اطبع("مجموع درجات الطالب:");
        اطبع(مجموع_الدرجات);
        اطبع("المعدل النهائي:");
        اطبع(المعدل);
        اطبع("حالة الطالب: ناجح ومبروك!");
    } وإلا {
        أحمد.ناجح = خطأ;
        اطبع("حالة الطالب: راسب");
    }
}.
