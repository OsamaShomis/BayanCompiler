برنامج اختبار_الخطأ_النحوي;

// ==============================================================================
// مثال (11): اختبار تشخيص الأخطاء النحوية المتعمدة (Syntax Diagnostics)
// الغرض: إثبات قدرة المترجم والمحرر على كشف الخطأ والقفز لموضع السطر
// ==============================================================================

متغير س, ص : صحيح;

{
    س = 10;
    // خطأ نحوي متعمد: نسيان طرف العملية الحسابية بعد المعامل +
    ص = س + ;
    اطبع(ص);
}.
