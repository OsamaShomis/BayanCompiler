برنامج نظام_تقديرات_الطلاب;

// ==============================================================================
// مثال (2): الجمل الشرطية والقرارات المنطقية
// يغطي: إذا ... فإن ... وإلا، المقارنات الشرطية (==, !=, <, <=, >, >=)
// ==============================================================================

ثابت درجة_النجاح = 50;
ثابت درجة_الامتياز = 90;

متغير درجة_الطالب : صحيح;
متغير حالة_النجاح : منطقي;

{
    درجة_الطالب = 85;

    اطبع("درجة الطالب المسجلة هي:", درجة_الطالب);

    // التحقق من النجاح
    إذا (درجة_الطالب >= درجة_النجاح) فإن {
        حالة_النجاح = صح;
        اطبع("النتيجة: الطالب ناجح بنجاح!");
    } وإلا {
        حالة_النجاح = خطأ;
        اطبع("النتيجة: الطالب لم يحقق درجة النجاح.");
    }

    // التحقق من التقدير الممتاز
    إذا (درجة_الطالب >= درجة_الامتياز) فإن {
        اطبع("التقدير: ممتاز مع مرتبة الشرف.");
    } وإلا {
        إذا (درجة_الطالب >= 75) فإن {
            اطبع("التقدير: جيد جداً.");
        } وإلا {
            اطبع("التقدير: جيد.");
        }
    }
}.
