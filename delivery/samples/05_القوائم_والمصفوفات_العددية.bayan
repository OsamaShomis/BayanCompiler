برنامج القوائم_والمصفوفات;

// ==============================================================================
// مثال (5): القوائم والمصفوفات وهياكل البيانات الخطية
// يغطي: نوع ... = قائمة[...] من صحيح، التعيين المفهرس، الوصول للعناصر
// ==============================================================================

نوع قائمة_درجات = قائمة[4] من صحيح;

متغير درجات : قائمة_درجات;
متغير مجموع_الدرجات : صحيح;
متغير متوسط_الدرجات : صحيح;

{
    // إسناد قيم عناصر القائمة
    درجات[0] = 80;
    درجات[1] = 90;
    درجات[2] = 85;
    درجات[3] = 95;

    // حساب المجموع والمتوسط بالقسمة الصحيحة
    مجموع_الدرجات = درجات[0] + درجات[1] + درجات[2] + درجات[3];
    متوسط_الدرجات = مجموع_الدرجات \ 4;

    اطبع("الدرجة الأولى:", درجات[0]);
    اطبع("الدرجة الثانية:", درجات[1]);
    اطبع("الدرجة الثالثة:", درجات[2]);
    اطبع("الدرجة الرابعة:", درجات[3]);
    اطبع("إجمالي درجات الطالب:", مجموع_الدرجات);
    اطبع("متوسط الدرجات التقديري:", متوسط_الدرجات);
}.
