برنامج اختبار_الخطأ_الدلالي;

// ==============================================================================
// مثال (12): اختبار تشخيص الأخطاء الدلالية المتعمدة (Semantic Diagnostics)
// الغرض: إثبات قدرة المحلل الدلالي على كشف تعارض الأنواع وحماية الثوابت
// ==============================================================================

ثابت النسبة_الرسمية = 10;
متغير عدد : صحيح;
متغير حالة : منطقي;

{
    عدد = 20;
    حالة = صح;

    // خطأ دلالي متعمد: محاولة جمع قيمة عددية صحيحة مع قيمة منطقية
    عدد = عدد + حالة;

    اطبع(عدد);
}.
